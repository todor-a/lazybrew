# Recording: vhs .github/themes/themes.tape
# One screenshot per built-in theme, cycled with t from the default.
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 12

Type "lazybrew"
Enter
Sleep 3s
Screenshot .github/themes/lazygit.png
Type "t"
Sleep 1s
Screenshot .github/themes/bright.png
Type "t"
Sleep 1s
Screenshot .github/themes/ocean.png
Type "t"
Sleep 1s
Screenshot .github/themes/dracula.png
Type "t"
Sleep 1s
Type "q"
Sleep 500ms
